node_modules/
extension/dist/
# Vendored out of node_modules by build.mjs, exactly like dist/. Committing them
# would mean two sources of truth for the same bytes.
extension/fonts/
bench/out/
spikes/**/result*.json
/tmp/

# Vendored ONNX Runtime (~97MB) and model weights (~112MB). Both are reproducible:
#   npm install && node setup.mjs
# See spikes/a-webgpu-vit/FINDINGS.md for why these specific models.
extension/ort/
extension/models/
spikes/**/ort/
*.onnx
bench/assets/
deck/*.pdf
deck/slide-*.jpg
dist-firefox/
server/.drill-fault

# macOS
.DS_Store

# briefing PDF preview renders
outreach/pg-*.jpg
outreach/b-*.jpg

# Python bytecode. These were tracked, so every server run showed as a diff.
__pycache__/
*.pyc

# Scratch probes used to reproduce a defect. Kept locally, never part of the repo.
probe*.ts

# Office lock files - appear whenever the deck is opened in PowerPoint
~$*

# The unpacked build Chrome loads via "Load unpacked" - a build output, never delete it
demo/privacy-agent-extension/
# ⛔ The BUILT ZIP, which used to be committed.
#
# It nearly shipped as v0.3.0. Packaging from a fresh clone failed — the name gazetteer is
# fetched by setup.mjs and is not in git — so package-extension.sh aborted and left the
# committed zip from the day before sitting in place, looking exactly like a fresh build.
# A build artefact in git is a stale build waiting to be mistaken for a current one.
demo/privacy-agent-extension.zip
extension/build-info.json
