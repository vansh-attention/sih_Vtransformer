# Shell scripts must keep LF endings.
#
# Git on Windows converts LF to CRLF by default, and bash then fails on the trailing
# \r with errors like "$'\r': command not found" — which reads as a syntax error in a
# script that is perfectly fine.
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.py text eol=lf
